# Normalize source/docs across Windows and Linux; preserve media byte-for-byte.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.gif binary
*.mp4 binary
# Historical inputs are hashed as exact bytes, including their line endings.
validation/approved_video/source_data.json -text
validation/independent_calculation.json -text
